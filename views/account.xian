{{> head}}
<body class="bg-slate-50">
{{> shellstart}}

  <nav aria-label="Breadcrumb" class="mb-4">
    <a href="/accounts" class="text-sm font-semibold text-brand-700 hover:underline">← Back to all accounts</a>
  </nav>

  <!-- Account header -->
  <section class="rounded-2xl bg-gradient-to-br from-brand-700 to-brand-900 p-6 text-white shadow-lg">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div>
        <p class="text-sm text-blue-100">Account number</p>
        <h1 class="text-2xl font-bold sm:text-3xl">{{account.AccountNumber}}</h1>
      </div>
      <div class="rounded-full bg-white px-1 py-1">{{> statuschip status=account.status}}</div>
    </div>
    <p class="mt-5 text-sm text-blue-100">Current balance</p>
    <p class="text-4xl font-extrabold tracking-tight sm:text-5xl">{{peso account.TotalBalance}}</p>
    <p class="mt-2 text-xs text-blue-200">Opened {{fmtDay account.created_at}} · Last changed {{fmtDate account.updated_at}}</p>
  </section>

  {{#if (eq account.status 'suspended')}}
  <div role="note" class="mt-4 rounded-xl bg-amber-50 p-4 text-sm text-amber-900 ring-1 ring-amber-300">⛔ This account is <strong>suspended</strong>. Check with an administrator before recording money in or out.</div>
  {{/if}}
  {{#if (eq account.status 'inactive')}}
  <div role="note" class="mt-4 rounded-xl bg-slate-100 p-4 text-sm text-slate-800 ring-1 ring-slate-300">⏸ This account is <strong>inactive</strong> (not currently in use).</div>
  {{/if}}

  {{#unless can.create}}
  <div class="mt-4 rounded-xl bg-sky-50 p-4 text-sm text-sky-900 ring-1 ring-sky-200">You're signed in as a <strong>{{roleInfo.label}}</strong>, so you can look at this account's history but not change it.</div>
  {{/unless}}

  {{#if can.create}}
  <div class="mt-6 grid gap-6 lg:grid-cols-2">

    <!-- Record a transaction -->
    <section aria-labelledby="tx-h" class="card">
      <h2 id="tx-h" class="text-lg font-bold text-slate-900">💸 Record money in or out</h2>
      <p class="mt-1 text-sm text-slate-600">Choose what happened, enter the amount, and press the button. The balance updates right away.</p>
      <form method="post" action="/accounts/{{account.id}}/transactions" class="mt-4 space-y-4" data-once>
        <fieldset>
          <legend class="label">What kind of transaction?</legend>
          <div class="grid grid-cols-1 gap-2 sm:grid-cols-3">
            <label class="block cursor-pointer">
              <input type="radio" name="type" value="deposit" class="peer sr-only" checked>
              <span class="flex min-h-[64px] flex-col items-center justify-center rounded-xl bg-white px-3 py-2 text-center text-sm font-semibold ring-1 ring-slate-300 peer-checked:bg-emerald-600 peer-checked:text-white peer-checked:ring-emerald-600 peer-focus-visible:ring-4 peer-focus-visible:ring-emerald-300"><span aria-hidden="true">⬇</span>Deposit<span class="text-xs font-normal opacity-80">Money in</span></span>
            </label>
            <label class="block cursor-pointer">
              <input type="radio" name="type" value="withdrawal" class="peer sr-only">
              <span class="flex min-h-[64px] flex-col items-center justify-center rounded-xl bg-white px-3 py-2 text-center text-sm font-semibold ring-1 ring-slate-300 peer-checked:bg-red-600 peer-checked:text-white peer-checked:ring-red-600 peer-focus-visible:ring-4 peer-focus-visible:ring-red-300"><span aria-hidden="true">⬆</span>Withdrawal<span class="text-xs font-normal opacity-80">Money out</span></span>
            </label>
            <label class="block cursor-pointer">
              <input type="radio" name="type" value="transfer" class="peer sr-only">
              <span class="flex min-h-[64px] flex-col items-center justify-center rounded-xl bg-white px-3 py-2 text-center text-sm font-semibold ring-1 ring-slate-300 peer-checked:bg-blue-600 peer-checked:text-white peer-checked:ring-blue-600 peer-focus-visible:ring-4 peer-focus-visible:ring-blue-300"><span aria-hidden="true">↗</span>Transfer<span class="text-xs font-normal opacity-80">Sent elsewhere</span></span>
            </label>
          </div>
        </fieldset>
        <div>
          <label for="tx_amount" class="label">Amount (₱) *</label>
          <input id="tx_amount" name="amount" type="number" inputmode="decimal" min="0.01" step="0.01" class="input" placeholder="0.00" required>
          <p class="hint">Withdrawals and transfers can't be more than the current balance.</p>
        </div>
        <div>
          <label for="tx_desc" class="label">Note (optional)</label>
          <input id="tx_desc" name="description" class="input" placeholder="e.g. Monthly savings" maxlength="255">
        </div>
        <button type="submit" class="btn btn-success w-full text-base">Record transaction</button>
      </form>
    </section>

    <!-- Account holder -->
    <section aria-labelledby="holder-h" class="card">
      <h2 id="holder-h" class="text-lg font-bold text-slate-900">👤 Account holder</h2>
      <p class="mt-1 text-sm text-slate-600">Who owns this account and how to reach them.</p>
      <form method="post" action="/accounts/{{account.id}}/holder" class="mt-4 space-y-4" data-once>
        <div>
          <label for="h_name" class="label">Full name *</label>
          <input id="h_name" name="full_name" class="input" value="{{holder.full_name}}" placeholder="e.g. Maria Santos" maxlength="150" required autocomplete="off">
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label for="h_email" class="label">Email</label>
            <input id="h_email" name="email" type="email" class="input" value="{{holder.email}}" placeholder="name@example.com" maxlength="100" autocomplete="off">
          </div>
          <div>
            <label for="h_phone" class="label">Phone</label>
            <input id="h_phone" name="phone" type="tel" class="input" value="{{holder.phone}}" placeholder="09XX XXX XXXX" maxlength="20" autocomplete="off">
          </div>
        </div>
        <div>
          <label for="h_addr" class="label">Address</label>
          <textarea id="h_addr" name="address" rows="2" class="input" placeholder="Street, city" autocomplete="off">{{holder.address}}</textarea>
        </div>
        <button type="submit" class="btn btn-primary w-full">Save holder details</button>
      </form>
    </section>
  </div>
  {{/if}}

  <!-- History -->
  <section aria-labelledby="hist-h" class="card mt-6">
    <h2 id="hist-h" class="text-lg font-bold text-slate-900">🧾 Transaction history</h2>
    {{#if transactions.length}}
    <ul class="mt-3 divide-y divide-slate-100">
      {{#each transactions}}
      <li class="flex items-center justify-between gap-3 py-3">
        <div class="min-w-0">
          <div class="flex flex-wrap items-center gap-2">
            {{> typechip type=type}}
            {{#if description}}<span class="truncate text-sm text-slate-600">{{description}}</span>{{/if}}
          </div>
          <p class="mt-1 text-xs text-slate-500">{{fmtDate created_at}}</p>
        </div>
        <p class="shrink-0 text-lg font-bold {{typeAmountClass type}}">{{typeSign type}}{{peso amount}}</p>
      </li>
      {{/each}}
    </ul>
    {{else}}
    <p class="mt-4 rounded-xl bg-slate-50 p-6 text-center text-sm text-slate-500">No transactions on this account yet.</p>
    {{/if}}
  </section>

  {{#if can.edit}}
  <section class="mt-6 flex flex-wrap items-center justify-between gap-3 rounded-2xl bg-white p-4 ring-1 ring-slate-200">
    <p class="text-sm text-slate-600">Need to correct the balance or change the status?</p>
    <button type="button" class="btn btn-ghost" data-open-dialog="editDialog">✏️ Edit balance &amp; status</button>
  </section>

  <dialog id="editDialog" aria-labelledby="editTitle">
    <form method="post" action="/accounts/{{account.id}}/update" class="p-6" data-once>
      <input type="hidden" name="return_to" value="detail">
      <h2 id="editTitle" class="text-xl font-bold text-slate-900">✏️ Edit account</h2>
      <p class="mt-1 text-sm text-slate-600">Account <strong>{{account.AccountNumber}}</strong></p>
      <div class="mt-5 space-y-4">
        <div>
          <label for="edit_bal" class="label">Balance (₱)</label>
          <input id="edit_bal" name="balance" type="number" inputmode="decimal" min="0" step="0.01" value="{{account.TotalBalance}}" class="input" required>
          <p class="hint">Use this only to correct a mistake. For normal deposits and withdrawals, record a transaction instead.</p>
        </div>
        <div>
          <label for="edit_status" class="label">Status</label>
          <select id="edit_status" name="status" class="input">
            <option value="active" {{selected account.status 'active'}}>✔ Active — working normally</option>
            <option value="inactive" {{selected account.status 'inactive'}}>⏸ Inactive — not in use</option>
            <option value="suspended" {{selected account.status 'suspended'}}>⛔ Suspended — temporarily blocked</option>
          </select>
        </div>
      </div>
      <div class="mt-6 flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
        <button type="button" class="btn btn-ghost" data-close-dialog>Cancel</button>
        <button type="submit" class="btn btn-primary">Save changes</button>
      </div>
    </form>
  </dialog>
  {{/if}}

{{> shellend}}
{{> footer}}
