{{> head}}
<body class="bg-slate-50">
{{> shellstart}}

  <header class="mb-6">
    <h1 class="text-2xl font-bold text-slate-900 sm:text-3xl">Hello, {{currentUser.username}} 👋</h1>
    <p class="mt-1 text-slate-600">Here's a quick look at all bank accounts right now.</p>
  </header>

  {{#unless can.edit}}
  <div class="mb-6 rounded-xl bg-sky-50 p-4 text-sm text-sky-900 ring-1 ring-sky-200">
    <strong>You're signed in as a {{roleInfo.label}}.</strong> {{roleInfo.blurb}}
  </div>
  {{/unless}}

  <!-- Big number -->
  <section aria-labelledby="total-h" class="rounded-2xl bg-gradient-to-br from-brand-700 to-brand-900 p-6 text-white shadow-lg">
    <h2 id="total-h" class="text-sm font-medium text-blue-100">Total money held across all accounts</h2>
    <p class="mt-1 text-4xl font-extrabold tracking-tight sm:text-5xl">{{peso stats.total}}</p>
    <p class="mt-1 text-sm text-blue-100">in {{stats.count}} {{plural stats.count 'account' 'accounts'}}</p>
  </section>

  <section aria-label="Balance statistics" class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-3">
    <div class="card">
      <p class="text-sm font-medium text-slate-500">Highest balance</p>
      <p class="mt-1 text-2xl font-bold text-slate-900">{{peso stats.max}}</p>
    </div>
    <div class="card">
      <p class="text-sm font-medium text-slate-500">Average balance</p>
      <p class="mt-1 text-2xl font-bold text-slate-900">{{peso stats.avg}}</p>
    </div>
    <div class="card">
      <p class="text-sm font-medium text-slate-500">Lowest balance</p>
      <p class="mt-1 text-2xl font-bold text-slate-900">{{peso stats.min}}</p>
    </div>
  </section>

  <!-- What do you want to do? -->
  <section aria-labelledby="quick-h" class="mt-8">
    <h2 id="quick-h" class="text-lg font-bold text-slate-900">What would you like to do?</h2>
    <div class="mt-3 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <a href="/accounts" class="card flex items-start gap-3 transition hover:ring-brand-400">
        <span aria-hidden="true" class="text-3xl">🔎</span>
        <span><strong class="block text-slate-900">Find an account</strong><span class="text-sm text-slate-600">Search by account number.</span></span>
      </a>
      {{#if can.create}}
      <a href="/accounts?new=1" class="card flex items-start gap-3 transition hover:ring-brand-400">
        <span aria-hidden="true" class="text-3xl">➕</span>
        <span><strong class="block text-slate-900">Open a new account</strong><span class="text-sm text-slate-600">Takes about a minute.</span></span>
      </a>
      <a href="/accounts" class="card flex items-start gap-3 transition hover:ring-brand-400">
        <span aria-hidden="true" class="text-3xl">💵</span>
        <span><strong class="block text-slate-900">Deposit or withdraw</strong><span class="text-sm text-slate-600">Pick an account, then record it.</span></span>
      </a>
      {{/if}}
      <a href="/transactions" class="card flex items-start gap-3 transition hover:ring-brand-400">
        <span aria-hidden="true" class="text-3xl">🧾</span>
        <span><strong class="block text-slate-900">See all transactions</strong><span class="text-sm text-slate-600">Money in and out, newest first.</span></span>
      </a>
      <a href="/summary" class="card flex items-start gap-3 transition hover:ring-brand-400">
        <span aria-hidden="true" class="text-3xl">📊</span>
        <span><strong class="block text-slate-900">Accounts by status</strong><span class="text-sm text-slate-600">Active, inactive and suspended.</span></span>
      </a>
    </div>
  </section>

  <div class="mt-8 grid gap-6 lg:grid-cols-5">
    <!-- Recent transactions -->
    <section aria-labelledby="recent-h" class="card lg:col-span-3">
      <div class="flex items-center justify-between">
        <h2 id="recent-h" class="text-lg font-bold text-slate-900">Latest transactions</h2>
        <a href="/transactions" class="text-sm font-semibold text-brand-700 hover:underline">See all →</a>
      </div>
      {{#if recent.length}}
      <ul class="mt-3 divide-y divide-slate-100">
        {{#each recent}}
        <li class="flex items-center justify-between gap-3 py-3">
          <div class="min-w-0">
            <p class="truncate text-sm font-semibold text-slate-900"><a href="/accounts/{{account_id}}" class="hover:underline">{{account.AccountNumber}}</a></p>
            <p class="truncate text-xs text-slate-500">{{typeLabel type}}{{#if description}} · {{description}}{{/if}} · {{fmtDate created_at}}</p>
          </div>
          <p class="shrink-0 text-base font-bold {{typeAmountClass type}}">{{typeSign type}}{{peso amount}}</p>
        </li>
        {{/each}}
      </ul>
      {{else}}
      <p class="mt-4 rounded-xl bg-slate-50 p-6 text-center text-sm text-slate-500">No transactions yet. They'll show up here once someone records a deposit or withdrawal.</p>
      {{/if}}
    </section>

    <!-- Status mini summary -->
    <section aria-labelledby="status-h" class="card lg:col-span-2">
      <div class="flex items-center justify-between">
        <h2 id="status-h" class="text-lg font-bold text-slate-900">Accounts by status</h2>
        <a href="/summary" class="text-sm font-semibold text-brand-700 hover:underline">Details →</a>
      </div>
      <ul class="mt-3 space-y-3">
        {{#each groups}}
        <li class="flex items-center justify-between gap-3 rounded-xl bg-slate-50 p-3">
          <div>{{> statuschip status=status}}</div>
          <div class="text-right">
            <p class="text-sm font-bold text-slate-900">{{accounts}} {{plural accounts 'account' 'accounts'}}</p>
            <p class="text-xs text-slate-500">{{peso balance}}</p>
          </div>
        </li>
        {{/each}}
      </ul>
    </section>
  </div>

{{> shellend}}
{{> footer}}
