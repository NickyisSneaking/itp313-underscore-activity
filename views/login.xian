{{> head}}
<body class="min-h-full bg-gradient-to-br from-brand-900 via-brand-800 to-brand-600">
  <div class="flex min-h-screen items-center justify-center px-4 py-10">
    <div class="w-full max-w-md">
      <div class="mb-6 text-center text-white">
        <div aria-hidden="true" class="text-5xl">🏦</div>
        <h1 class="mt-2 text-2xl font-bold">Bank Account Manager</h1>
        <p class="mt-1 text-sm text-blue-100">Sign in to view and manage bank accounts.</p>
      </div>

      <div class="rounded-2xl bg-white p-6 shadow-2xl sm:p-8">
        <h2 class="text-xl font-bold text-slate-900">Welcome back</h2>

        {{#if info}}
        <div role="status" class="mt-4 rounded-xl bg-sky-50 p-3 text-sm font-medium text-sky-900 ring-1 ring-sky-200">👋 {{info}}</div>
        {{/if}}
        {{#if error}}
        <div role="alert" class="mt-4 rounded-xl bg-red-50 p-3 text-sm font-medium text-red-900 ring-1 ring-red-200">⚠️ {{error}}</div>
        {{/if}}
        {{#each error_msg}}
        <div role="alert" class="mt-4 rounded-xl bg-red-50 p-3 text-sm font-medium text-red-900 ring-1 ring-red-200">⚠️ {{this}}</div>
        {{/each}}

        <form method="POST" action="/login" class="mt-5 space-y-5" data-once>
          <div>
            <label for="username" class="label">Username</label>
            <input type="text" id="username" name="username" value="{{username}}" class="input" placeholder="Your username" autocomplete="username" autocapitalize="none" required autofocus>
          </div>
          <div>
            <label for="password" class="label">Password</label>
            <div class="relative">
              <input type="password" id="password" name="password" class="input pr-20" placeholder="Your password" autocomplete="current-password" required>
              <button type="button" data-toggle-password="password" class="absolute inset-y-0 right-1 my-1 rounded-lg px-3 text-sm font-semibold text-brand-700 hover:bg-brand-50" aria-controls="password">Show</button>
            </div>
          </div>
          <button type="submit" class="btn btn-primary w-full text-base">Sign in</button>
        </form>

        <details class="mt-6 text-sm text-slate-600">
          <summary class="cursor-pointer font-semibold text-slate-700">Need help signing in?</summary>
          <ul class="mt-2 list-disc space-y-1 pl-5">
            <li>Don't have an account yet? Ask an administrator to create one for you.</li>
            <li>After 3 wrong passwords in a row, sign-in is paused for 5 minutes to keep accounts safe.</li>
            <li>Passwords are case-sensitive.</li>
          </ul>
        </details>
      </div>
    </div>
  </div>
{{> footer}}
