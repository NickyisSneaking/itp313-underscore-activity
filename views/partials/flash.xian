{{#if success_msg.length}}
<div aria-live="polite" class="mb-5 space-y-3">
  {{#each success_msg}}
  <div role="status" data-flash class="flex items-start gap-3 rounded-xl bg-emerald-50 p-4 text-emerald-900 ring-1 ring-emerald-200">
    <span aria-hidden="true" class="text-lg leading-none">✅</span>
    <p class="flex-1 text-sm font-medium">{{this}}</p>
    <button type="button" data-dismiss class="rounded-md px-2 text-emerald-800 hover:bg-emerald-100" aria-label="Dismiss message">✕</button>
  </div>
  {{/each}}
</div>
{{/if}}
{{#if error_msg.length}}
<div aria-live="assertive" class="mb-5 space-y-3">
  {{#each error_msg}}
  <div role="alert" data-flash class="flex items-start gap-3 rounded-xl bg-red-50 p-4 text-red-900 ring-1 ring-red-200">
    <span aria-hidden="true" class="text-lg leading-none">⚠️</span>
    <p class="flex-1 text-sm font-medium">{{this}}</p>
    <button type="button" data-dismiss class="rounded-md px-2 text-red-800 hover:bg-red-100" aria-label="Dismiss message">✕</button>
  </div>
  {{/each}}
</div>
{{/if}}
