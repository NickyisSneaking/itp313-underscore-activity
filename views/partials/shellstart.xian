<a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-50 focus:rounded-lg focus:bg-white focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:shadow-lg">Skip to main content</a>

<div class="min-h-screen lg:flex">

  <!-- Top bar (phones & tablets) -->
  <header class="sticky top-0 z-30 flex items-center justify-between bg-brand-900 px-4 py-3 text-white lg:hidden">
    <a href="/dashboard" class="flex items-center gap-2 text-base font-bold"><span aria-hidden="true">🏦</span> Bank Account Manager</a>
    <button type="button" data-menu-toggle aria-expanded="false" aria-controls="sidebar" class="min-h-[44px] rounded-lg bg-white/10 px-4 text-sm font-semibold hover:bg-white/20">☰ Menu</button>
  </header>

  <div data-menu-backdrop class="fixed inset-0 z-30 hidden bg-slate-900/50 lg:hidden"></div>

  <!-- Side menu -->
  <aside id="sidebar" class="fixed inset-y-0 left-0 z-40 flex w-72 -translate-x-full flex-col overflow-y-auto bg-brand-900 text-white transition-transform duration-200 lg:sticky lg:top-0 lg:h-screen lg:translate-x-0">
    <div class="flex items-center justify-between px-5 py-5">
      <a href="/dashboard" class="flex items-center gap-2 text-lg font-bold"><span aria-hidden="true" class="text-2xl">🏦</span> Bank Account<br class="hidden">Manager</a>
      <button type="button" data-menu-close class="rounded-lg px-3 py-2 text-sm text-blue-100 hover:bg-white/10 lg:hidden" aria-label="Close menu">✕</button>
    </div>

    <nav aria-label="Main" class="flex-1 space-y-1 px-3">
      <a href="/dashboard" class="flex min-h-[48px] items-center gap-3 rounded-xl px-4 text-base font-medium {{navClass active 'dashboard'}}" {{#if (eq active 'dashboard')}}aria-current="page"{{/if}}><span aria-hidden="true" class="w-6 text-center">🏠</span> Overview</a>
      <a href="/accounts" class="flex min-h-[48px] items-center gap-3 rounded-xl px-4 text-base font-medium {{navClass active 'accounts'}}" {{#if (eq active 'accounts')}}aria-current="page"{{/if}}><span aria-hidden="true" class="w-6 text-center">📋</span> Accounts</a>
      <a href="/transactions" class="flex min-h-[48px] items-center gap-3 rounded-xl px-4 text-base font-medium {{navClass active 'transactions'}}" {{#if (eq active 'transactions')}}aria-current="page"{{/if}}><span aria-hidden="true" class="w-6 text-center">💸</span> Transactions</a>
      <a href="/summary" class="flex min-h-[48px] items-center gap-3 rounded-xl px-4 text-base font-medium {{navClass active 'summary'}}" {{#if (eq active 'summary')}}aria-current="page"{{/if}}><span aria-hidden="true" class="w-6 text-center">📊</span> Accounts by status</a>
      {{#if can.audit}}
      <p class="px-4 pb-1 pt-4 text-xs font-semibold uppercase tracking-wider text-blue-300">Admin only</p>
      <a href="/audit" class="flex min-h-[48px] items-center gap-3 rounded-xl px-4 text-base font-medium {{navClass active 'audit'}}" {{#if (eq active 'audit')}}aria-current="page"{{/if}}><span aria-hidden="true" class="w-6 text-center">🔍</span> Activity log</a>
      <a href="/security" class="flex min-h-[48px] items-center gap-3 rounded-xl px-4 text-base font-medium {{navClass active 'security'}}" {{#if (eq active 'security')}}aria-current="page"{{/if}}><span aria-hidden="true" class="w-6 text-center">🔐</span> Sign-in security</a>
      {{/if}}
    </nav>

    <div class="m-3 rounded-2xl bg-white/10 p-4">
      <div class="flex items-center gap-3">
        <span aria-hidden="true" class="flex h-10 w-10 items-center justify-center rounded-full bg-white text-base font-bold text-brand-900">{{initial currentUser.username}}</span>
        <div class="min-w-0">
          <p class="truncate text-sm font-semibold">{{currentUser.username}}</p>
          <p class="text-xs text-blue-200">{{roleInfo.label}}</p>
        </div>
      </div>
      <a href="/profile" class="mt-3 flex min-h-[44px] items-center justify-center rounded-xl text-sm font-semibold {{navClass active 'profile'}} ring-1 ring-inset ring-white/25">👤 My profile &amp; password</a>
      <form method="post" action="/logout" class="mt-2">
        <button type="submit" class="flex min-h-[44px] w-full items-center justify-center rounded-xl bg-white text-sm font-semibold text-brand-900 hover:bg-blue-50">Sign out</button>
      </form>
    </div>
  </aside>

  <div class="min-w-0 flex-1">
    <main id="main" class="mx-auto w-full max-w-6xl px-4 py-6 sm:px-6 lg:px-8 lg:py-8">
      {{> flash}}
